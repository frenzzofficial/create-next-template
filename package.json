{
  "name": "create-next-template",
  "version": "1.0.5",
  "description": "A top 1% Next.js template for building modern apps.",
  "private": true,
  "scripts": {
    "themes:build": "bun run src/packages/scripts/build-themes.ts",
    "predev": "bun run themes:build",
    "prebuild": "bun run themes:build",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --fix .",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "verify": "bun run lint && bun run format && bun run check && bun run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.40.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.87.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "author": "@frenzzofficial",
  "license": "CC0-1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/frenzzofficial/create-next-template.git"
  },
  "keywords": [
    "nextjs",
    "next",
    "template",
    "create-next-template",
    "typescript",
    "tailwindcss",
    "bun",
    "turbopack",
    "biome"
  ]
}
